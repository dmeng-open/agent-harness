# Copy to .env and fill in. Never commit .env.
# anthropic/... models call the Anthropic API directly; any other model goes
# through OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# HARNESS_AGENT_MODEL=anthropic/claude-haiku-5-5   # the model LM() calls
# HARNESS_USER_MODEL=anthropic/claude-haiku-5-5    # plays the simulated users
# HARNESS_JUDGE_MODEL=anthropic/claude-sonnet-5-5  # scores evaluation transcripts
# HARNESS_REASONING_EFFORT=low # reasoning effort for models that accept it
# HARNESS_BUDGET_USD=25        # your own stop: the LM wrapper refuses new calls once the ledger reaches this
# HARNESS_EVAL_SLICE=5         # run live tests on the first N items only
